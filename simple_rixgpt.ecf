<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0"
		name="simple_rixgpt" uuid="34a45fff-d2fe-48e9-8304-2888e0e08b92" library_target="simple_rixgpt">
	<description>RixGPT - a character-level GPT whose whole forward pass is pure Eiffel</description>
	<target name="simple_rixgpt">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<setting name="total_order_on_reals" value="true"/>
		<capability>
			<concurrency support="scoop" use="thread"/>
			<void_safety support="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_rixgpt_tests" extends="simple_rixgpt">
		<root class="TEST_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<cluster name="tests" location=".\testing\" recursive="true"/>
		<cluster name="app" location=".\app\" recursive="true"/>
	</target>
	<target name="simple_rixgpt_app" extends="simple_rixgpt">
		<root class="RIXGPT_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<setting name="executable_name" value="simple_rixgpt"/>
		<cluster name="app" location=".\app\" recursive="true"/>
	</target>
</system>
